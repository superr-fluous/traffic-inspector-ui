 "info": {
  "title": "Traffic Inspector Web API",
  "version": "1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/dashboard/add": {
   "post": {
    "description": "Adds existing widget to Dashboard",
    "operationId": "dashboard-add-widget",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AddDashboardWidgetParamsBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Success with no response body"
     },
     "204": {
      "description": "No Content"
     },
     "400": {
      "content": {
       "application/json": {
        "example": {
         "error": "Validation error",
         "detail": "[ShouldBindJson Error]"
        }
       }
      },
      "description": "Invalid request"
     },
     "500": {
      "content": {
       "application/json": {
        "example": {
         "error": "Database error",
         "detail": "[Database Error]"
        }
       }
      },
      "description": "Database error"
     }
    },
    "summary": "Add widget to Dashboard",
    "tags": [
     "dashboard",
     "widget",
     "POST"
    ]
   }
  },
  "/dashboard/delete": {
   "delete": {
    "description": "Delete existing widget from Dashboard",
    "operationId": "dashboard-delete-widget",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DeleteDashboardWidgetParamsBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Success with no response body"
     },
     "204": {
      "description": "No Content"
     },
     "400": {
      "content": {
       "application/json": {
        "example": {
         "error": "Validation error",
         "detail": "[ShouldBindJson Error]"
        }
       }
      },
      "description": "Invalid request"
     },
     "409": {
      "content": {
       "application/json": {
        "example": {
         "error": "No widgets affected"
        }
       }
      },
      "description": "No effect"
     },
     "500": {
      "content": {
       "application/json": {
        "example": {
         "error": "Database error",
         "detail": "[Database Error]"
        }
       }
      },
      "description": "Internal server error"
     }
    },
    "summary": "Delete widget from Dashboard",
    "tags": [
     "dashboard",
     "widget",
     "DELETE"
    ]
   }
  },
  "/dashboard/layout": {
   "patch": {
    "description": "Update widgets' layouts",
    "operationId": "dashboard-update-layout",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/UpdateDashboardLayoutBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Success with no response body"
     },
     "204": {
      "description": "No Content"
     },
     "400": {
      "content": {
       "application/json": {
        "example": {
         "error": "Validation error",
         "detail": "[ShouldBindJson Error]"
        }
       }
      },
      "description": "Validation error"
     },
     "500": {
      "content": {
       "application/json": {
        "example": {
         "error": "Database error",
         "detail": "[Database Error]"
        }
       }
      },
      "description": "Internal server error"
     }
    },
    "summary": "Update widget layouts",
    "tags": [
     "dashboard",
     "widget",
     "PATCH"
    ]
   }
  },
  "/widget": {
   "put": {
    "description": "Make new widget",
    "operationId": "create-widget",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Widget"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Success with no response body"
     },
     "204": {
      "description": "No Content"
     },
     "400": {
      "content": {
       "application/json": {
        "example": {
         "error": "Invalid request",
         "detail": "[ShouldBindJson Error]"
        }
       }
      },
      "description": "Invalid request"
     },
     "409": {
      "content": {
       "application/json": {
        "example": {
         "error": "Widget already exists"
        }
       }
      },
      "description": "Widget already exists"
     },
     "500": {
      "content": {
       "application/json": {
        "example": {
         "error": "Database error",
         "detail": "[Database error]"
        }
       }
      },
      "description": "Internal server error"
     }
    },
    "summary": "Create a widget",
    "tags": [
     "widget",
     "CREATE"
    ]
   }
  },
  "/widget/{id}": {
   "delete": {
    "description": "Delete widget (also deletes it from Dashboard)",
    "operationId": "delete-widget",
    "parameters": [
     {
      "in": "path",
      "name": "widgetID",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Success with no response body"
     },
     "204": {
      "description": "No Content"
     },
     "500": {
      "content": {
       "application/json": {
        "example": {
         "error": "Database error",
         "detail": "[Database error]"
        }
       }
      },
      "description": "Internal server error"
     }
    },
    "summary": "Delete widget",
    "tags": [
     "widget",
     "DELETE"
    ]
   },
   "get": {
    "description": "Get widget by an ID",
    "operationId": "get-widget",
    "parameters": [
     {
      "in": "path",
      "name": "widgetID",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Widget"
        }
       }
      },
      "description": "OK"
     },
     "404": {
      "content": {
       "application/json": {
        "example": {
         "error": "Widget not found"
        }
       }
      },
      "description": "Not found"
     },
     "500": {
      "content": {
       "application/json": {
        "example": {
         "error": "Database error",
         "detail": "[Database error]"
        }
       }
      },
      "description": "Database error"
     }
    },
    "summary": "Get widget",
    "tags": [
     "widget",
     "GET"
    ]
   },
   "patch": {
    "description": "Change widget object",
    "operationId": "patch-widget",
    "parameters": [
     {
      "in": "path",
      "name": "widgetID",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PatchWidgetParamsBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Success with no response body"
     },
     "204": {
      "description": "No Content"
     },
     "409": {
      "content": {
       "application/json": {
        "example": {
         "error": "No effect",
         "detail": "No widgets affected"
        }
       }
      },
      "description": "No effect"
     },
     "500": {
      "content": {
       "application/json": {
        "example": {
         "error": "Database error",
         "detail": "[Database error]"
        }
       }
      },
      "description": "Internal server error"
     }
    },
    "summary": "Patch widget",
    "tags": [
     "widget",
     "PATCH"
    ]
   }
  },
  "/widget/{id}/bookmark/{state}": {
   "patch": {
    "description": "Add/remove widget from Dashboard",
    "operationId": "toggle-widget-bookmark",
    "parameters": [
     {
      "in": "path",
      "name": "widgetID",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "state",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Success with no response body"
     },
     "204": {
      "description": "No Content"
     },
     "400": {
      "content": {
       "application/json": {
        "example": {
         "error": "Validation error",
         "detail": "value must be 'true' or 'false', received [state]"
        }
       }
      },
      "description": "Invalid request"
     },
     "500": {
      "content": {
       "application/json": {
        "example": {
         "error": "Database error",
         "detail": "[Database error]"
        }
       }
      },
      "description": "Internal server error"
     }
    },
    "summary": "Toggle widget's bookmark state",
    "tags": [
     "widget",
     "PATCH"
    ]
   }
  }
 },
 "servers": [
  {
   "url": "http://localhost:8000/api/v1"
  }
 ]
}
